# Copy to .env and fill in. NEVER commit .env.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL is the only database (no SQLite fallback).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=csr_intelligence_django
MYSQL_USER=
MYSQL_PASSWORD=

# Optional legacy read-only source for one-time imports
LEGACY_MYSQL_DB=csr_intelligence

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ImpactBridge <noreply@impactbridge.org>

# ==============================================================================
# AI-Powered Page Classification & Discovery Configuration
# ==============================================================================

# Active Architecture: Gemini Primary (Free Tier) + Grok Fallback (Zero Cost Only)
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=grok
AI_FALLBACK_ENABLED=true

# Google Gemini Configuration (Official API Free Tier Only)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your-gemini-api-key-here
# Confirmed free-tier models: gemini-2.5-flash, gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-flash-8b

# xAI Grok Fallback Configuration (Strict Zero-Cost Policy)
GROK_MODEL=grok-2-latest
GROK_API_KEY=your-xai-api-key-here
GROK_ZERO_COST_ONLY=true
GROK_FREE_CREDITS_CONFIRMED=false
# IMPORTANT: Free Grok web/app accounts do NOT provide free API usage.
# Only set GROK_FREE_CREDITS_CONFIRMED=true if your xAI account has confirmed,
# non-billable promotional/grant credits covering calls at zero cost.

# Alternative Provider: OpenRouter Free Models Router
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_MODEL=openrouter/free

# Operational Flags
AI_CLASSIFICATION_ENABLED=true
AI_DRY_RUN=true
AI_CACHE_ENABLED=true
MAX_API_CALLS_PER_RUN=50


